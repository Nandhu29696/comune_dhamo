# ---------- Frontend (Vite; must be prefixed with VITE_) ----------
# Public origin used for canonical URLs and JSON-LD.
VITE_SITE_URL=http://localhost:5173
# Base URL of the API. Leave empty to use the same origin (Vite dev proxy / reverse proxy in prod).
VITE_API_BASE_URL=https://comuneindustriesapi1.vercel.app/api
# Google reCAPTCHA v3 site key (optional — forms still work without it).
VITE_RECAPTCHA_SITE_KEY=
# Google Analytics 4 measurement id (optional).
VITE_GA_MEASUREMENT_ID=
# WhatsApp number (digits only, with country code) for the chat widget.
VITE_WHATSAPP_NUMBER=919876543210

# ---------- Backend (server/.env) ----------
PORT=4000
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173
# reCAPTCHA v3 secret. When set, tokens are verified with Google before a submission is accepted.
RECAPTCHA_SECRET=
# Optional SMTP delivery. When SMTP_HOST is empty, submissions are only written to server/data/submissions.json.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=website@example.com
MAIL_TO=sales@example.com
